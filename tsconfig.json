{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["@webgpu/types", "node", "vite/client"],
		"experimentalDecorators": true,
		"useDefineForClassFields": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": "src",
		"outDir": "dist",
		"noEmitOnError": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts", "**/*.spec.ts", "src/renderer/test", "**/__tests__/**"]
}
