{
	"name": "@rsw/mc-java-render-ts",
	"version": "1.0.3",
	"description": "红石阁 mc java TypeScript SDK：蓝图渲染、材料、容器、红石、实体与相机",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./renderer": {
			"types": "./dist/renderer/index.d.ts",
			"import": "./dist/renderer/index.js"
		},
		"./mesh": {
			"types": "./dist/mesh/core/index.d.ts",
			"import": "./dist/mesh/core/index.js"
		},
		"./mesh/three": {
			"types": "./dist/mesh/three/index.d.ts",
			"import": "./dist/mesh/three/index.js"
		},
		"./mesh/worker": {
			"types": "./dist/mesh/worker/index.d.ts",
			"import": "./dist/mesh/worker/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:consumer": "tsc --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --noEmit tests/public-api.ts",
		"test": "pnpm run build && pnpm run typecheck:consumer && node --test tests/*.test.mjs && pnpm run test:renderer",
		"test:renderer": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev:example": "pnpm run build && vite example --config example/vite.config.js",
		"build:example": "vite build example --config example/vite.config.js",
		"lint": "eslint src/renderer",
		"schematics:coverage": "node scripts/generate-coverage-schematics.mjs",
		"nucleation:local": "node scripts/use-local-nucleation.mjs",
		"benchmark:nucleation": "node --expose-gc scripts/benchmark-nucleation.mjs"
	},
	"dependencies": {
		"@ffmpeg/ffmpeg": "0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"events": "3.3.0",
		"express": "^5.3.0",
		"jszip": "3.10.2",
		"lil-gui": "0.19.2",
		"lodash": "^4.18.1",
		"n8ao": "^1.10.3",
		"nucleation": "npm:@coastlinecreations/nucleation@0.10.24",
		"postprocessing": "6.39.5",
		"three": "0.186.1",
		"@types/three": "0.186.0",
		"@types/node": "24.19.1",
		"d3": "^7.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "1.62.0",
		"@types/d3": "^7.4.3",
		"@types/lodash": "^4.17.25",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"@webgpu/types": "^0.1.74",
		"chokidar": "^5.0.0",
		"concurrently": "^8.2.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"fs-extra": "^11.4.1",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.9",
		"simplex-noise": "^4.0.3",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.0.0",
		"vite": "8.3.5",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
